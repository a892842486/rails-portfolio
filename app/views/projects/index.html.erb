<div class="bg-gray-50 p-8">
  <div class="mx-auto max-w-6xl">

    <h1 class="mb-8 text-3xl font-bold">Projects</h1>

    <div class="grid gap-6 md:grid-cols-2">
      <% @projects.each do |project| %>
        <div class="rounded-xl bg-white p-6 shadow ring-1 ring-gray-200 transition-shadow hover:shadow-md">
          <h2 class="text-xl font-semibold">
            <%= link_to project.name, project_path(project), class: "hover:underline" %>
          </h2>

          <p class="mt-2 text-gray-600"><%= project.summary %></p>

          <div class="mt-3 flex flex-wrap gap-2">
            <% project.skills.each do |skill| %>
              <%= render "shared/badge", text: skill.name %>
            <% end %>
          </div>

          <% cover_image = project.project_images.order(:created_at).first %>

          <% if cover_image&.image&.attached? %>
            <%= link_to project_path(project) do %>
              <%= image_tag cover_image.image, class: "mt-4 w-full rounded-lg" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>