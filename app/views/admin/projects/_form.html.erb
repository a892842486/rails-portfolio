<%= form_with model: [:admin, project] do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :summary %>
    <%= form.text_field :summary %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :skills %>
    <%= form.collection_check_boxes :skill_ids, Skill.order(:position), :id, :name %>
  </div>

  <div>
    <%= form.fields_for :links do |link_form| %>
      <%= link_form.hidden_field :id %>

      <%= link_form.label :label %>
      <%= link_form.text_field :label %>

      <%= link_form.label :url %>
      <%= link_form.text_field :url %>

      <%= link_form.check_box :_destroy %>
      <%= link_form.label :_destroy, "Delete" %>
    <% end %>
  </div>

  <div>
    <%= form.label :images %>
    <%= form.file_field :images, multiple: true %>
  </div>

  <%= form.submit %>
  
<% end %>

<% project.images.each do |image| %>
  <div>
    <%= image_tag image, width: 300 %>

    <%= button_to "Delete",
                  destroy_image_admin_project_path(project),
                  method: :delete,
                  params: { image_id: image.id } %>
  </div>
<% end %>