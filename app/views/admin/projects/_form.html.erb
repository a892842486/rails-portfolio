<%= form_with model: [:admin, project] do |form| %>
  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :summary %>
    <%= form.text_field :summary %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :skills %>
    <%= form.collection_check_boxes :skill_ids, Skill.order(:position), :id, :name %>
  </div>

  <div>
    <%= form.fields_for :links do |link_form| %>
      <%= link_form.hidden_field :id %>

      <%= link_form.label :label %>
      <%= link_form.text_field :label %>

      <%= link_form.label :url %>
      <%= link_form.text_field :url %>

      <%= link_form.check_box :_destroy %>
      <%= link_form.label :_destroy, "Delete" %>
    <% end %>
  </div>

  <div data-controller="project-images">

    <div data-project-images-target="list">
      <%= form.fields_for :project_images do |image_form| %>
        <div>
          <%= image_form.hidden_field :id %>

          <% if image_form.object.persisted? && image_form.object.image.attached? %>
            <%= image_tag image_form.object.image, width: 300 %>
          <% end %>

          <%= image_form.label :caption, "Caption" %>
          <%= image_form.text_field :caption %>

          <%= image_form.label :image, "Image" %>
          <%= image_form.file_field :image %>

          <%= image_form.check_box :_destroy %>
          <%= image_form.label :_destroy, "Delete" %>
        </div>
      <% end %>
    </div>


    <template data-project-images-target="template">
      <%= form.fields_for :project_images, ProjectImage.new, child_index: "NEW_RECORD" do |image_form| %>
        <div>
          <%= image_form.hidden_field :id %>

          <%= image_form.label :caption, "Caption" %>
          <%= image_form.text_field :caption %>

          <%= image_form.label :image, "Image" %>
          <%= image_form.file_field :image %>

          <%= image_form.check_box :_destroy %>
          <%= image_form.label :_destroy, "Delete" %>
        </div>
      <% end %>
    </template>

    <button type="button"
            id="add-project-image"
            data-action="click->project-images#add">
      Add Project Image
    </button>

  </div>

  <%= form.submit %>
  
<% end %>
