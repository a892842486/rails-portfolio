<h1>Projects</h1>

<%= link_to "New Project", new_admin_project_path %>

<div>
  <% @projects.each do |project| %>
    <div>
      <h2><%= project.name %></h2>
      <p><%= project.summary %></p>
      <p><%= project.description %></p>

      <% cover_image = project.project_images.order(:created_at).first %>

      <% if cover_image&.image&.attached? %>
        <%= image_tag cover_image.image, class: "mt-4 w-full rounded-lg" %>
      <% end %>

      <% project.links.each do |link| %>
        <%= link_to link.label, link.url %>
      <% end %>

      <%= link_to "Edit", edit_admin_project_path(project) %>

      <%= button_to "Delete",
                    admin_project_path(project),
                    method: :delete %>
      </div>
  <% end %>
</div>